#!/bin/sh
# Install the source-only MC-Web distribution without git or administrator
# access. The archive is always fetched from the pinned public repository and
# is unpacked into a private user directory. A user-owned directory is never
# overwritten unless it carries the marker created by this script.
set -eu

REPOSITORY="vano04/mcweb"
REF="main"
ARCHIVE_URL="https://github.com/$REPOSITORY/archive/refs/heads/$REF.tar.gz"
MAX_ARCHIVE_BYTES=134217728
INSTALL_DIR="${MCWEB_INSTALL_DIR:-${HOME:-}/.mcweb/project}"

say() { echo "mcweb: $*"; }
die() { echo "mcweb: $*" >&2; exit 1; }

case "${1:-}" in
  --help|-h)
    echo "Usage: ./install [--dry-run]"
    echo "Set MCWEB_INSTALL_DIR to choose a different destination."
    exit 0
    ;;
  --dry-run) DRY_RUN=1 ;;
  "") DRY_RUN=0 ;;
  *) die "unknown option: $1 (use --dry-run or --help)" ;;
esac

[ -n "$INSTALL_DIR" ] || die "MCWEB_INSTALL_DIR must not be empty"
case "$INSTALL_DIR" in
  /*) ;;
  *) INSTALL_DIR="$PWD/$INSTALL_DIR" ;;
esac

PARENT_DIR=$(dirname "$INSTALL_DIR")
if [ "$DRY_RUN" -eq 1 ]; then
  say "dry-run: no downloads or writes"
  say "repository: https://github.com/$REPOSITORY"
  say "ref: $REF"
  say "archive: $ARCHIVE_URL"
  say "destination: $INSTALL_DIR"
  say "after install: cd '$INSTALL_DIR' && ./run.sh"
  exit 0
fi

command -v curl >/dev/null 2>&1 || die "curl is required"
command -v tar >/dev/null 2>&1 || die "tar is required"
mkdir -p "$PARENT_DIR"

if [ -e "$INSTALL_DIR" ] || [ -L "$INSTALL_DIR" ]; then
  MARKER="$INSTALL_DIR/.mcweb-install.json"
  [ -f "$MARKER" ] || die "refusing to overwrite existing directory without $MARKER: $INSTALL_DIR"
  grep -F '"repository": "vano04/mcweb"' "$MARKER" >/dev/null 2>&1 \
    || die "refusing to overwrite a directory not installed by MC-Web: $INSTALL_DIR"
fi

WORK_DIR=$(mktemp -d "$PARENT_DIR/.mcweb-install.XXXXXX") \
  || die "could not create a temporary install directory under $PARENT_DIR"
cleanup() { rm -rf "$WORK_DIR"; }
trap cleanup EXIT HUP INT TERM
ARCHIVE="$WORK_DIR/mcweb.tar.gz"
LISTING="$WORK_DIR/archive.list"
EXTRACTED="$WORK_DIR/extracted"
mkdir "$EXTRACTED"

say "downloading $REPOSITORY@$REF"
EFFECTIVE_URL=$(curl --fail --silent --show-error --location \
  --max-redirs 3 --proto '=https' --tlsv1.2 --connect-timeout 15 --max-time 300 \
  --max-filesize "$MAX_ARCHIVE_BYTES" -o "$ARCHIVE" -w '%{url_effective}' "$ARCHIVE_URL") \
  || die "could not download the GitHub source archive"
case "$EFFECTIVE_URL" in
  "$ARCHIVE_URL"|"https://codeload.github.com/$REPOSITORY/tar.gz/refs/heads/$REF") ;;
  *) die "GitHub archive redirected outside the pinned repository: $EFFECTIVE_URL" ;;
esac

tar -tzf "$ARCHIVE" > "$LISTING" \
  || die "downloaded GitHub archive is not a valid tar.gz"
awk '
  /^\// || /(^|\/)\.\.(\/|$)/ { bad=1 }
  END { exit bad ? 1 : 0 }
' "$LISTING" || die "GitHub archive contains an unsafe path"
ROOT_NAME=$(awk -F/ 'NF > 1 { print $1; exit }' "$LISTING")
[ "$ROOT_NAME" = "mcweb-$REF" ] || die "unexpected GitHub archive root: ${ROOT_NAME:-missing}"

tar -xzf "$ARCHIVE" -C "$EXTRACTED" --strip-components=1 \
  || die "could not extract the GitHub source archive"
[ -f "$EXTRACTED/README.md" ] || die "source archive is missing README.md"
[ -f "$EXTRACTED/tools/mcweb-install.mjs" ] || die "source archive is missing the local installer"
[ -f "$EXTRACTED/run.sh" ] || die "source archive is missing run.sh"

printf '%s\n' '{' '  "schema": 1,' '  "repository": "vano04/mcweb",' \
  '  "ref": "main",' '  "managedBy": "mcweb/install"' '}' > "$EXTRACTED/.mcweb-install.json"

BACKUP=""
if [ -e "$INSTALL_DIR" ] || [ -L "$INSTALL_DIR" ]; then
  BACKUP="$INSTALL_DIR.backup.$(date +%Y%m%d%H%M%S)"
  while [ -e "$BACKUP" ] || [ -L "$BACKUP" ]; do BACKUP="$BACKUP.$$"; done
  mv "$INSTALL_DIR" "$BACKUP" || die "could not move the previous MC-Web install to $BACKUP"
fi
if ! mv "$EXTRACTED" "$INSTALL_DIR"; then
  [ -z "$BACKUP" ] || mv "$BACKUP" "$INSTALL_DIR" || true
  die "could not install MC-Web into $INSTALL_DIR"
fi

say "installed source checkout at $INSTALL_DIR"
[ -z "$BACKUP" ] || say "previous managed checkout kept at $BACKUP"
say "next: cd '$INSTALL_DIR' && ./run.sh"
